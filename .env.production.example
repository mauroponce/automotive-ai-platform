NODE_ENV=production
DOMAIN=photos.example.com
NEXTAUTH_URL=https://photos.example.com
NEXTAUTH_SECRET=generate-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
POSTGRES_DB=automotive
POSTGRES_USER=automotive
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://automotive:replace-with-a-strong-password@postgres:5432/automotive?schema=public
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
APP_DEMO_MODE=false
API_KEY_PEPPER=generate-a-long-random-secret
S3_ENDPOINT=https://your-hetzner-bucket.eu-central-1.your-objectstorage.com
S3_REGION=eu-central-1
S3_BUCKET=automotive-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
WORKER_CONCURRENCY=1
