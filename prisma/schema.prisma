generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationRole {
  OWNER
  DEALERSHIP_ADMIN
  DEALERSHIP_STAFF
}
enum PlatformRole {
  USER
  SUPER_ADMIN
}
enum AssetKind {
  VEHICLE
  SHOWROOM
  LOGO
  GENERATED
  EVALUATION_ARTIFACT
}
enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
  NEEDS_REVIEW
}
enum VehicleProcessingBatchStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}
enum VehicleProcessingItemStatus {
  QUEUED
  SUBMITTED
  PROCESSING
  NEEDS_REVIEW
  APPROVED
  REJECTED
  FAILED
}
enum VehicleBackgroundSource {
  PLATFORM_PRESET
  ORGANIZATION_ASSET
  BATCH_UPLOAD
}
enum VehiclePlateTreatment {
  BLUR
  HIDE
  REGISTERED_TEMPLATE
}
enum PlateLabExperimentStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELED
}
enum PlateLabAnnotationState {
  PENDING
  ANNOTATED
  NO_VISIBLE_PLATE
}
enum ShowroomLabExperimentStatus {
  DRAFT
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id String @id @default(cuid())
  name String?
  email String? @unique
  emailVerified DateTime?
  image String?
  passwordHash String?
  platformRole PlatformRole @default(USER)
  roleChangedAt DateTime?
  accounts Account[]
  sessions Session[]
  memberships Membership[]
  plateLabExperiments PlateLabExperiment[] @relation("PlateLabExperimentOwner")
  showroomLabExperiments ShowroomLabExperiment[] @relation("ShowroomLabExperimentOwner")
}
model ShowroomLabExperiment {
  id String @id @default(cuid())
  ownerId String
  status ShowroomLabExperimentStatus @default(DRAFT)
  configuration Json
  startedAt DateTime?
  completedAt DateTime?
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("ShowroomLabExperimentOwner", fields:[ownerId], references:[id], onDelete: Cascade)
  images ShowroomLabImage[]
  backgrounds ShowroomLabBackground[]
}
model ShowroomLabImage {
  id String @id @default(cuid())
  experimentId String
  originalName String
  artifactKey String @unique
  contentType String
  byteSize Int
  width Int
  height Int
  errorMessage String?
  createdAt DateTime @default(now())
  experiment ShowroomLabExperiment @relation(fields:[experimentId], references:[id], onDelete: Cascade)
  runs ShowroomLabRun[]
}
model ShowroomLabBackground {
  id String @id @default(cuid())
  experimentId String
  originalName String
  artifactKey String @unique
  contentType String
  byteSize Int
  width Int
  height Int
  createdAt DateTime @default(now())
  experiment ShowroomLabExperiment @relation(fields:[experimentId], references:[id], onDelete: Cascade)
  runs ShowroomLabRun[]
}
model ShowroomLabRun {
  id String @id @default(cuid())
  imageId String
  backgroundId String
  modelId String
  maskArtifactKey String @unique
  outputArtifactKey String @unique
  preprocessingMs Int
  inferenceMs Int
  postprocessingMs Int
  warnings Json
  createdAt DateTime @default(now())
  image ShowroomLabImage @relation(fields:[imageId], references:[id], onDelete: Cascade)
  background ShowroomLabBackground @relation(fields:[backgroundId], references:[id], onDelete: Cascade)
  @@unique([imageId, backgroundId, modelId])
}
model PlateLabExperiment {
  id String @id @default(cuid())
  ownerId String
  status PlateLabExperimentStatus @default(DRAFT)
  configuration Json
  selectedModelId String?
  startedAt DateTime?
  completedAt DateTime?
  canceledAt DateTime?
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("PlateLabExperimentOwner", fields:[ownerId], references:[id], onDelete: Cascade)
  images PlateLabImage[]
  metricSnapshots PlateLabMetricSnapshot[]
}
model PlateLabImage {
  id String @id @default(cuid())
  experimentId String
  originalName String
  artifactKey String @unique
  checksum String
  contentType String
  byteSize Int
  width Int
  height Int
  status String @default("queued")
  errorMessage String?
  createdAt DateTime @default(now())
  experiment PlateLabExperiment @relation(fields:[experimentId], references:[id], onDelete: Cascade)
  detections PlateLabDetectionRun[]
  outputs PlateLabOutput[]
  annotationRevisions PlateLabAnnotationRevision[]
}
model PlateLabDetectionRun {
  id String @id @default(cuid())
  imageId String
  modelId String
  strategy String
  threshold Float
  iouThreshold Float?
  detections Json
  preprocessingMs Int
  inferenceMs Int
  postprocessingMs Int
  warnings Json
  errorMessage String?
  createdAt DateTime @default(now())
  image PlateLabImage @relation(fields:[imageId], references:[id], onDelete: Cascade)
  @@unique([imageId, modelId, strategy, threshold, iouThreshold])
}
model PlateLabOutput {
  id String @id @default(cuid())
  imageId String
  modelId String
  method String
  marginPercent Float
  artifactKey String @unique
  contentType String
  byteSize Int
  detectionCount Int
  createdAt DateTime @default(now())
  image PlateLabImage @relation(fields:[imageId], references:[id], onDelete: Cascade)
}
model PlateLabAnnotationRevision {
  id String @id @default(cuid())
  imageId String
  revision Int
  state PlateLabAnnotationState
  boxes Json
  tags Json
  createdAt DateTime @default(now())
  image PlateLabImage @relation(fields:[imageId], references:[id], onDelete: Cascade)
  @@unique([imageId, revision])
}
model PlateLabMetricSnapshot {
  id String @id @default(cuid())
  experimentId String
  annotationRevisionIds Json
  metrics Json
  createdAt DateTime @default(now())
  experiment PlateLabExperiment @relation(fields:[experimentId], references:[id], onDelete: Cascade)
}
model AdminAuditEvent {
  id String @id @default(cuid())
  actorId String?
  subjectUserId String
  action String
  createdAt DateTime @default(now())
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
model Organization {
  id String @id @default(cuid())
  name String
  trialStartedAt DateTime @default(now())
  trialEndsAt DateTime
  memberships Membership[]
  assets Asset[]
  jobs GenerationJob[]
  vehicleProcessingBatches VehicleProcessingBatch[]
  pilotEntitlement PilotOrganizationEntitlement?
  registeredPlateTemplates RegisteredPlateTemplate[]
}
model Membership {
  organizationId String
  userId String
  role OrganizationRole
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([organizationId, userId])
}
model Asset {
  id String @id @default(cuid())
  organizationId String
  kind AssetKind
  objectKey String @unique
  contentType String
  byteSize Int
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batchSourceItems VehicleProcessingItem[] @relation("VehicleBatchSourceAsset")
  batchOutputItems VehicleProcessingItem[] @relation("VehicleBatchOutputAsset")
  batchBackgrounds VehicleProcessingBatch[] @relation("VehicleBatchBackgroundAsset")
  plateTemplate RegisteredPlateTemplate?
}
model PilotOrganizationEntitlement {
  organizationId String @id
  grantedVehicleBatches Int @default(0)
  reservedVehicleBatches Int @default(0)
  consumedVehicleBatches Int @default(0)
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}
model RegisteredPlateTemplate {
  id String @id @default(cuid())
  organizationId String
  assetId String @unique
  name String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}
model VehicleProcessingBatch {
  id String @id @default(cuid())
  organizationId String
  vehicleLabel String
  status VehicleProcessingBatchStatus @default(DRAFT)
  idempotencyKey String
  backgroundSource VehicleBackgroundSource
  backgroundAssetId String?
  backgroundSnapshot Json
  plateTreatment VehiclePlateTreatment
  plateTemplateId String?
  configuration Json
  providerBatchId String? @unique
  providerInputFileId String?
  actualProviderCostUsd Float @default(0)
  nonProviderCostUsd Float @default(0)
  entitlementReservedAt DateTime?
  entitlementConsumedAt DateTime?
  startedAt DateTime?
  completedAt DateTime?
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  backgroundAsset Asset? @relation("VehicleBatchBackgroundAsset", fields: [backgroundAssetId], references: [id])
  items VehicleProcessingItem[]
  @@unique([organizationId, idempotencyKey])
}
model VehicleProcessingItem {
  id String @id @default(cuid())
  batchId String
  sourceAssetId String
  outputAssetId String? @unique
  status VehicleProcessingItemStatus @default(QUEUED)
  providerCustomId String @unique
  providerRequestId String?
  promptSnapshot String
  usage Json?
  providerCostUsd Float?
  evaluation Json?
  errorMessage String?
  approvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  batch VehicleProcessingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sourceAsset Asset @relation("VehicleBatchSourceAsset", fields: [sourceAssetId], references: [id])
  outputAsset Asset? @relation("VehicleBatchOutputAsset", fields: [outputAssetId], references: [id])
  @@unique([batchId, sourceAssetId])
}
model PromptTemplate {
  id String @id @default(cuid())
  name String @unique
  description String?
  versions PromptVersion[]
}
model PromptVersion {
  id String @id @default(cuid())
  promptTemplateId String
  version Int
  promptText String
  template PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)
  jobs GenerationJob[]
  @@unique([promptTemplateId, version])
}
model ModelRegistry {
  id String @id @default(cuid())
  modelIdentifier String @unique
}
model GenerationJob {
  id String @id @default(cuid())
  organizationId String
  promptVersionId String
  status JobStatus @default(QUEUED)
  requestedSettings Json
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion @relation(fields: [promptVersionId], references: [id])
  attempts GenerationAttempt[]
}
model GenerationAttempt {
  id String @id @default(cuid())
  jobId String
  provider String
  modelIdentifier String
  status JobStatus
  errorMessage String?
  job GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
}
