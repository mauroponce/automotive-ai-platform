{
  "name": "automotive-ai-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --format=cjs --external:@prisma/client --external:sharp --outfile=dist/worker.cjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "bash ops/migrate.sh",
    "db:push": "prisma db push",
    "worker": "tsx worker/index.ts",
    "auth:promote-super-admin": "tsx scripts/promote-super-admin.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "lucide-react": "^1.56.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "onnxruntime-web": "^1.30.0",
    "openai": "^7.32.0",
    "pg-boss": "^12.38.0",
    "pica": "^10.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^6.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "~0.28.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4"
  }
}
